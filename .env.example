# Database
DATABASE_URL="postgresql://nipris_user:nipris_secure_password@localhost:5432/nipris_db?schema=public"

# Redis Cache & Queues
REDIS_URL="redis://localhost:6379"

# API Server Configuration
PORT=4000
NODE_ENV="development"

# Authentication Secrets (Replace in Production environment vault)
JWT_ACCESS_SECRET="CHANGE_ME_IN_PRODUCTION_JWT_ACCESS_SECRET_KEY_32_BYTES"
JWT_REFRESH_SECRET="CHANGE_ME_IN_PRODUCTION_JWT_REFRESH_SECRET_KEY_32_BYTES"

# Object Storage (S3 Compatible)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="minio_admin"
S3_SECRET_KEY="minio_secure_password"
S3_EVIDENCE_BUCKET="nipris-evidence-vault"
