# Production Multi-Stage Dockerfile for NIPRIS NestJS Backend API
FROM node:20-alpine AS builder

WORKDIR /app

COPY package*.json ./
COPY packages/types/package*.json ./packages/types/
COPY apps/backend/package*.json ./apps/backend/

RUN npm ci --workspace=@nipris/types --workspace=@nipris/backend

COPY packages/types ./packages/types
COPY apps/backend ./apps/backend

RUN npm run build --workspace=@nipris/types
RUN npm run build --workspace=@nipris/backend

FROM node:20-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production

COPY --from=builder /app/package*.json ./
COPY --from=builder /app/packages/types/dist ./packages/types/dist
COPY --from=builder /app/packages/types/package*.json ./packages/types/
COPY --from=builder /app/apps/backend/dist ./apps/backend/dist
COPY --from=builder /app/apps/backend/package*.json ./apps/backend/

RUN npm ci --only=production --workspace=@nipris/types --workspace=@nipris/backend

USER node

EXPOSE 3001

CMD ["node", "apps/backend/dist/main.js"]
